<?xml version="1.0" encoding="utf-8"?>
<!--
  Backup Android 11- (fullBackupContent). Incluye DB (listas del usuario) y
  prefs de ubicación. EXCLUYE el token cifrado: la MasterKey vive en el
  Keystore del dispositivo y no sobrevive al restore → token restaurado
  sería indescifrable y rompería el arranque de sesión.
-->
<full-backup-content>
    <include domain="database" path="." />
    <include domain="sharedpref" path="." />
    <include domain="file" path="datastore/" />
    <exclude domain="sharedpref" path="secure_auth_prefs.xml" />
</full-backup-content>
